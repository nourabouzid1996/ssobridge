---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import ContactUs from '~/components/widgets/Contact.astro';
const googlePlayImg = '~/assets/images/image_copy.png';

const metadata = {
  title: 'SSOBridge — ',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      /*{
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/onwidget/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },*/
      { text: 'Ajouter le SSO à mon SaaS', href: 'account' },
    ]}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight"> SAML prêt pour la production via seulement 2 endpoints </span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Pensé pour les développeurs, prêt pour la production, et conçu pour accélérer la signature de clients entreprise.
</span>
      </span>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <!-- Content Widget **************** -->

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Compatible avec les principaux fournisseurs d’identité',
        description: `SSOBridge s’intègre facilement avec les principaux fournisseurs d’identité (Okta, Google, Microsoft, etc.).
          SAML, OAuth ou OpenID Connect — une intégration simple, quel que soit votre fournisseur.`,
      },
      
    ]}
    image={{
          src: googlePlayImg,

      alt: 'CANVA',
    }}
  >
    <!--Fragment slot="content">Ensure your online presence truly represents you.</Fragment-->

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
     items={[
      {
        title: 'SSO avec tous les IdP, via 2 endpoints',
        description: `Une seule intégration, deux endpoints API, et le support des principaux Identity Providers (Okta, Microsoft, Google, Auth0, Keycloak).
        Activez le SSO entreprise (SAML & OIDC) en quelques minutes.`,
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>

    {/* Tabs container */}
<Fragment slot="image">
  <div class="relative w-full px-2 sm:px-4 lg:px-0">
    
    <!-- Glow background -->
    <div class="absolute -inset-2 sm:-inset-4 bg-gradient-to-r from-blue-500 via-indigo-500 to-cyan-500 opacity-20 blur-2xl rounded-3xl"></div>

    <!-- Code container -->
    <div class="relative w-full max-w-3xl mx-auto bg-[#020617] border border-slate-800 rounded-xl sm:rounded-2xl shadow-2xl overflow-hidden">
      
      <!-- Top bar (mac style) -->
      <div class="flex items-center justify-between px-3 sm:px-5 py-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-red-500"></span>
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-yellow-500"></span>
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-green-500"></span>
        </div>
        <span class="text-[10px] sm:text-xs text-slate-400 font-mono">
          curl • SAML integration (2 endpoints)
        </span>
      </div>

      <!-- Scrollable code (responsive fix) -->
      <div class="w-full overflow-x-auto">
        <pre class="min-w-[650px] sm:min-w-0 p-4 sm:p-6 text-[12px] sm:text-sm md:text-[14px] leading-relaxed font-mono text-slate-300">
{`# Replace {auth_id} and {api_key} with your credentials

# 1. Get SAML / OIDC login URL
curl -X GET "https://api.ssobridge.com/v1/saml/login/{auth_id}" \\
  -H "Authorization: Bearer {api_key}" \\
  -H "Content-Type: application/json"

# Redirect your user to the returned login_url

# 2. Exchange access code (SSO callback)
curl -X GET "https://api.ssobridge.com/v1/saml/code" \\
  -H "Authorization: Bearer {api_key}" \\
  -H "Content-Type: application/json"

# Done. User authenticated with enterprise SSO.`}
        </pre>
      </div>

    </div>
  </div>
</Fragment>
  </Content>

  {/* Tab Switching Script */}
  <script>
    const tabs = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active-tab'));
        tab.classList.add('active-tab');

        tabPanes.forEach((pane) => {
          pane.classList.add('hidden');
          pane.classList.remove('active');
        });

        tabPanes[index].classList.remove('hidden');
        tabPanes[index].classList.add('active');
      });
    });
  </script>

  <!-- Content Widget **************** -->

  <!-- Steps Widget ******************  Un besoin spécifique ? Nous pouvons le prendre en charge rapidement. -->

